# Foodly iOS - Fastlane Lanes
# Usage:
#   bundle exec fastlane beta          → Build + upload to TestFlight
#   bundle exec fastlane beta_upload   → Upload existing IPA to TestFlight (skip build)
#   bundle exec fastlane release       → Build + submit to App Store Review
#   bundle exec fastlane metadata      → Upload App Store text metadata only (no binary)

default_platform(:ios)

# Dart defines shared across all build lanes
#
# Nota sobre `GOOGLE_MAPS_API_KEY` (2026-05-07):
#   El path activo de Places/Geocoding en producción es el Foodly Places Proxy
#   backend (Fase 5 del proxy, 2026-04-23). Los 3 call-sites Dart que
#   consumían `BaseConfig.googleDefaultApiKey` quedaron como fallback legacy
#   detrás de `placesProxyEnabled = false` y sólo se ejecutan si el flag se
#   baja. Por eso se removió el fallback hardcodeado a la Android Maps key
#   `AIza...MSL4` (que además ahora está restringida por package+SHA-1 a la
#   app Android — desde iOS sería rechazada igual).
#
#   Si por algún motivo se rollbackea el Places Proxy:
#     1. Re-agregar Places + Geocoding a la clave iOS auto-created by Firebase
#        (`AIza...sbxA`) en GCP Console.
#     2. Exportar `GOOGLE_MAPS_API_KEY=AIza...sbxA` antes de correr fastlane.
#   Si la env var no está seteada, el dart-define queda en string vacío y
#   `BaseConfig.googleDefaultApiKey` retorna `''` — los call-sites legacy
#   tirarían un REQUEST_DENIED ruidoso de Google, no un fallo silencioso.
DART_DEFINES = [
  "ENV=prod",
  "DOMAIN=https://api.foodly.solutions",
  "API_VERSION=/api",
  "REG_PREFILL=true",
  "APP_ROOT=/app/",
  "LOGGER_LEVEL=ALL",
  'GOOGLE_MAPS_GEOCODING_URL=https://maps.googleapis.com/maps/api/geocode/json?latlng=',
  "GOOGLE_MAPS_API_KEY=#{ENV['GOOGLE_MAPS_API_KEY'] || ''}",
  "GOOGLE_SIGN_IN_CLIENT_ID=#{ENV['GOOGLE_SIGN_IN_CLIENT_ID'] || '951890938827-gjo39ar4r70btq1ik1r09l8dmqklt19p.apps.googleusercontent.com'}",
  "OPENAI_API_KEY=#{ENV['OPENAI_API_KEY']}",
  "REPLICATE_API_KEY=#{ENV['REPLICATE_API_KEY']}",
  "ANALYTICS_TOKEN=#{ENV['ANALYTICS_TOKEN']}",
  "STRIPE_PUBLISHABLE_KEY=#{ENV['STRIPE_PUBLISHABLE_KEY']}",
  "APPLE_MERCHANT_ID=#{ENV['APPLE_MERCHANT_ID'] || 'merchant.solutions.foodly.app'}",
].freeze

# Falla ANTES de compilar, no en el iPhone del tester.
def verify_payment_env!
  key = ENV['STRIPE_PUBLISHABLE_KEY'].to_s
  UI.user_error!(
    "Falta STRIPE_PUBLISHABLE_KEY. Sin ella la build sale sin pagos.\n" \
    "  export STRIPE_PUBLISHABLE_KEY=pk_test_...   (o pk_live_ para producción)"
  ) if key.empty?

  UI.user_error!("STRIPE_PUBLISHABLE_KEY no parece una clave publicable (pk_test_/pk_live_)") \
    unless key.start_with?('pk_test_', 'pk_live_')

  UI.important("⚠️  Stripe en modo TEST — no sirve para la App Store") if key.start_with?('pk_test_')
  UI.message("Stripe: …#{key[-4..]} · merchant: #{ENV['APPLE_MERCHANT_ID'] || 'merchant.solutions.foodly.app'}")
end

platform :ios do

  desc "Build Flutter IPA and upload to TestFlight"
  lane :beta do
    verify_payment_env!

    # Step 1: Clean Flutter build
    Dir.chdir("../..") do
      sh("flutter", "clean")
      sh("flutter", "pub", "get")
    end

    # Step 2: Pod install
    cocoapods(
      podfile: "./Podfile",
      repo_update: true,
    )

    # Step 3: Build IPA via Flutter
    dart_define_args = DART_DEFINES.map { |d| "--dart-define=#{d}" }
    Dir.chdir("../..") do
      sh("flutter", "build", "ipa", "--release", *dart_define_args)
    end

    # Step 4: Find the built IPA
    ipa_path = Dir.glob("../../build/ios/ipa/*.ipa").first
    UI.user_error!("No IPA found in build/ios/ipa/") unless ipa_path
    ipa_path = File.expand_path(ipa_path)
    UI.message("Found IPA: #{ipa_path}")

    # Step 5: Upload dSYMs to Firebase Crashlytics
    dsyms_dir = Dir.glob("../../build/ios/archive/Runner.xcarchive/dSYMs").first
    if dsyms_dir && File.directory?(File.expand_path(dsyms_dir))
      dsyms_dir = File.expand_path(dsyms_dir)
      dsym_zip = File.join(File.dirname(dsyms_dir), "dSYMs.zip")
      UI.message("Zipping dSYMs from: #{dsyms_dir}")
      Dir.chdir(dsyms_dir) do
        sh("zip", "-r", dsym_zip, ".")
      end
      UI.message("Uploading dSYMs zip: #{dsym_zip}")
      upload_symbols_to_crashlytics(
        dsym_path: dsym_zip,
        gsp_path: "./Runner/GoogleService-Info.plist",
        binary_path: "./Pods/FirebaseCrashlytics/upload-symbols",
      )
      UI.success("✅ dSYMs uploaded to Crashlytics!")
    else
      UI.important("⚠️  No dSYMs directory found — skipping Crashlytics upload")
    end

    # Step 6: Upload to TestFlight
    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "New beta build for testing",
    )

    UI.success("✅ Build uploaded to TestFlight successfully!")
  end

  desc "Upload an existing IPA to TestFlight (skip build)"
  lane :beta_upload do
    ipa_path = ENV["IPA_PATH"] || Dir.glob("../../build/ios/ipa/*.ipa").first
    UI.user_error!("No IPA found. Build first or set IPA_PATH.") unless ipa_path
    ipa_path = File.expand_path(ipa_path)

    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "New beta build for testing",
    )

    UI.success("✅ IPA uploaded to TestFlight successfully!")
  end

  desc "Build and submit to App Store for review"
  lane :release do
    verify_payment_env!

    # Step 1: Clean Flutter build
    Dir.chdir("../..") do
      sh("flutter", "clean")
      sh("flutter", "pub", "get")
    end

    # Step 2: Pod install
    cocoapods(
      podfile: "./Podfile",
      repo_update: true,
    )

    # Step 3: Build IPA via Flutter
    dart_define_args = DART_DEFINES.map { |d| "--dart-define=#{d}" }
    Dir.chdir("../..") do
      sh("flutter", "build", "ipa", "--release", *dart_define_args)
    end

    # Step 4: Find the built IPA
    ipa_path = Dir.glob("../../build/ios/ipa/*.ipa").first
    UI.user_error!("No IPA found in build/ios/ipa/") unless ipa_path
    ipa_path = File.expand_path(ipa_path)

    # Step 5: Upload dSYMs to Firebase Crashlytics
    dsyms_dir = Dir.glob("../../build/ios/archive/Runner.xcarchive/dSYMs").first
    if dsyms_dir && File.directory?(File.expand_path(dsyms_dir))
      dsyms_dir = File.expand_path(dsyms_dir)
      dsym_zip = File.join(File.dirname(dsyms_dir), "dSYMs.zip")
      UI.message("Zipping dSYMs from: #{dsyms_dir}")
      Dir.chdir(dsyms_dir) do
        sh("zip", "-r", dsym_zip, ".")
      end
      UI.message("Uploading dSYMs zip: #{dsym_zip}")
      upload_symbols_to_crashlytics(
        dsym_path: dsym_zip,
        gsp_path: "./Runner/GoogleService-Info.plist",
        binary_path: "./Pods/FirebaseCrashlytics/upload-symbols",
      )
      UI.success("✅ dSYMs uploaded to Crashlytics!")
    else
      UI.important("⚠️  No dSYMs directory found — skipping Crashlytics upload")
    end

    # Step 6: Upload to App Store
    upload_to_app_store(
      ipa: ipa_path,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: false, # Set to true when ready to auto-submit
      automatic_release: false,
      precheck_include_in_app_purchases: false,
    )

    UI.success("✅ Build uploaded to App Store Connect!")
    UI.important("⚠️  Remember to submit for review manually in App Store Connect")
  end

  # Sube SOLO los textos de la ficha de App Store (no binario, no capturas).
  #
  # Por qué este lane existe: el lane `release` sube el binario con
  # `skip_metadata: true`, así que la ficha (descripción, keywords, subtítulo,
  # etc.) nunca se empuja desde Fastlane. Este lane lee `fastlane/metadata/`
  # —estructura de Fastlane deliver, con carpetas por locale (en-US, es-MX,
  # es-ES, pt-PT)— y publica esos textos en App Store Connect de una sola vez.
  #
  # `skip_binary_upload` → no toca la build (la 1.6.1+46 ya está subida).
  # `skip_screenshots`   → las capturas se suben aparte por consola.
  # `force: true`        → omite la preview HTML interactiva; verificá el
  #                        resultado en App Store Connect después de correrlo.
  # `submit_for_review: false` → NO envía a revisión; eso es un paso manual.
  desc "Upload App Store text metadata only (no binary, no screenshots, no submit)"
  lane :metadata do
    upload_to_app_store(
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
    )
    UI.success("✅ Metadata de App Store subida. Verificá en App Store Connect → Distribución.")
  end

end
