# Foodly iOS - Fastlane Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git!

# App Store Connect API key — la via preferente.
#
# Con estas tres variables fastlane NO usa el login por Apple ID: ni Olympus, ni
# contrasena especifica de app, ni sesiones que caducan a mitad de una subida.
# Si faltan, los lanes caen al Apple ID de abajo y todo sigue igual.
#
# ASC_KEY_ID es el sufijo del fichero: AuthKey_XXXXXXXXXX.p8 -> XXXXXXXXXX
# ASC_ISSUER_ID esta arriba del todo en App Store Connect -> Users and Access
#   -> Integrations -> Keys
# ASC_KEY_PATH apunta al .p8, que NUNCA va en el repo.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# Apple Developer Account (el camino de respaldo)
APPLE_ID=owentours@gmail.com
TEAM_ID=V76AZLAYJ4
ITC_TEAM_ID=V76AZLAYJ4

# API Keys (move from hardcoded values in tasks.json)
ANALYTICS_TOKEN=

# Optional overrides (defaults are set in Fastfile)
# GOOGLE_MAPS_API_KEY=
# GOOGLE_SIGN_IN_CLIENT_ID=
