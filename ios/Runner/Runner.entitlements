<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:menu.foodly.solutions</string>
		<!-- Órdenes grupales (2026-08-12). Android ya declaraba
		     foodly.solutions/join en su manifest; iOS no, así que en iPhone
		     TODA invitación a una orden grupal abría Safari en vez de la app
		     — el feature social simplemente no funcionaba en la mitad de los
		     dispositivos. Cubre además el retorno del Checkout hosteado
		     (/checkout/return/*), que vive en el mismo dominio. -->
		<string>applinks:foodly.solutions</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Apple Pay (2026-08-10). El identificador debe existir en el portal de
	     Apple (Certificates → Identifiers → Merchant IDs) y coincidir con el
	     que se pasa por la dart-define APPLE_MERCHANT_ID. Si no coincide, la
	     hoja de pago simplemente NO ofrece Apple Pay, sin error visible.
	     (Ojo: aquí no se puede escribir el doble guion de la flag; XML lo
	     prohíbe dentro de un comentario y rompe el parseo del plist.) -->
	<key>com.apple.developer.in-app-payments</key>
	<array>
		<string>merchant.solutions.foodly.app</string>
	</array>
</dict>
</plist>
