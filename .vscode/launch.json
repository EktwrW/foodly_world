  // Las capturas de tienda van en tres idiomas y cada negocio demo tiene el
  // menú en uno: el correo se elige al arrancar en vez de vivir en el entorno.
  // La contraseña sigue en LOG_PASS, que es la misma para los tres.
  "inputs": [
    {
      "id": "cuentaDemo",
      "type": "pickString",
      "description": "Con qué cuenta demo arrancar",
      "default": "userdemo1@mail.com",
      "options": [
        { "label": "userdemo1 — The Pizzeria Restaurant (menú en inglés)", "value": "userdemo1@mail.com" },
        { "label": "userdemo2 — Taberna da Cidade (menú en portugués)", "value": "userdemo2@mail.com" },
        { "label": "userdemo3 — Mega Pizzas (menú en español)", "value": "userdemo3@mail.com" }
      ]
    }
