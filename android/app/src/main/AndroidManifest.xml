<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        Phones-only para el lanzamiento Fase 1 (PT/AR/VE/ES).
        Declaramos explícitamente que NO soportamos large/xlarge screens
        (tablets, Chromebooks, foldables abiertos) para que:
          - Play Store NO muestre la app en el listing como "compatible con
            tablets / Chromebook" — eso engañaba a Hector y lo reportó como
            bug post-go-live 1.6.4.
          - El catálogo de dispositivos Play se filtre por nosotros
            (complemento a la exclusión manual de 6.073 modelos hecha al
            preparar el primer release).
        Cuando la UI responsive esté lista (proyecto de tablet en Q3 2026),
        revertir esto a `largeScreens="true" xlargeScreens="true"` y subir
        screenshots de tablet a la ficha de Play Store.
        Ver memoria `project_phones_only_launch.md` para contexto completo.
    -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="false"
        android:xlargeScreens="false"
        android:resizeable="true"
        android:anyDensity="true" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Push notifications: Android 13+ (API 33+) requires POST_NOTIFICATIONS
         declared in the manifest AND requested at runtime via
         FirebaseMessaging.instance.requestPermission(). Without this, FCM
         payloads still arrive (in-app logic fires on open) but the OS
         silently drops the tray notification — matching the "no push on
         Android phone/tablet but in-app dialog works" bug seen in
         PT-launch smoke tests. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Para login: -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
    <!-- Para busquedas por voz: -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Para la geolocalización: -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
        Foto/vídeo del dispositivo: Foodly los usa de forma puntual (subir avatar,
        portada de negocio, item de menú, post a Buzz) — NO como función principal.
        Política Play 2024+ prohíbe declarar READ_MEDIA_IMAGES y READ_MEDIA_VIDEO en
        ese escenario; la app debe usar el Photo Picker del sistema, que es
        precisamente lo que image_picker 1.x hace por defecto en Android 13+.

        Usamos tools:node="remove" en vez de simplemente omitir las líneas para
        bloquear también cualquier reintroducción vía manifest merger desde plugins
        (file_picker, image_cropper, etc.). Bug bloqueante detectado al intentar
        publicar el bundle 49 a producción (Play Console, 2026-05-31).
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <queries>
        <!-- check for SMS support -->
        <intent>
            <action
                android:name="android.intent.action.VIEW"/>
            <data
                android:scheme="sms"/>
        </intent>
        <!-- check for call support -->
        <intent>
            <action
                android:name="android.intent.action.VIEW"/>
            <data
                android:scheme="tel"/>
        </intent>
        <!-- check for https support -->
        <intent>
            <action
                android:name="android.intent.action.VIEW"/>
            <data
                android:scheme="https"/>
        </intent>
        <intent>
            <action
                android:name="android.intent.action.SEND"/>
            <data
                android:mimeType="*/*"/>
        </intent>
        <!-- check for inAppBrowserView launch mode support -->
        <intent>
            <action
                android:name="android.support.customtabs.action.CustomTabsService"/>
        </intent>
        <!-- check for voice recognition support -->
        <intent>
            <action 
                android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <application
        android:label="Foodly"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:roundIcon="@mipmap/ic_launcher_round">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyA2EUJDudKf-67bKDrpGeGJfKxYjmlMSL4"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep Links: open menu.foodly.solutions/{businessUuid} in-app -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="menu.foodly.solutions"/>
            </intent-filter>
            <!-- App Links F3a: invitaciones a órdenes grupales
                 (foodly.solutions/join/{code} → join automático in-app).
                 Verificado contra /.well-known/assetlinks.json de la landing. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="foodly.solutions" android:pathPrefix="/join"/>
                <!-- Retorno del Checkout hosteado (2026-08-12). Faltaba por
                     completo: iOS lo cubría vía AASA pero Android no declaraba
                     el path, así que en Android volver de MB WAY abría el
                     navegador en vez de la app, con el comensal recién pagando.
                     Mismo host ya verificado, solo un path más. -->
                <data android:scheme="https" android:host="foodly.solutions" android:pathPrefix="/checkout/return"/>
            </intent-filter>
        </activity>
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Ucrop.CropTheme"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <!-- FCM: ícono monocromo + color de acento para pushes (bug e2e 4:
             el launcher a color se veía invisible/deforme en la status bar). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_foodly" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
